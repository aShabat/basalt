/api

  /session
    post /                  create session (login); sets AuthToken cookie
    delete /                destroy session (logout); clears AuthToken cookie

  /users
    post /                  create user (signup)
    get /                   find users (?name=...)
    get /me                 authenticated user
    get /:user_id           user data
    get /:user_id/tree      folder/note tree
    get /:user_id/graph     link graph

  /notes
    post /                  create note; path is computed from folder + title
    get /:note_id           note including content
    patch /:note_id         update content and privacy
    post /:note_id/rename/preview  preview path and link changes
    post /:note_id/rename          rename note and update links
    delete /:note_id        delete note

  /folders
    post /                  create folder; path is computed from parent + title
    get /:folder_id         folder
    post /:folder_id/rename/preview  preview path and link changes
    post /:folder_id/rename          rename folder, descendants, and links
    delete /:folder_id      delete folder
